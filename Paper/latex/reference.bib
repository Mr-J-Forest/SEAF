@article{WangZhaoYingJiYuGaiJinBPNNDeShengSuChangFenCengJianMo2024,
  title = {Hierarchical Modeling of Sound Velocity Field Based on Improved BPNN},
  author = {Wang, Zhaoying and Chai, Hongzhou and Du, Zhenqiang},
  journal = {Acta Geodaetica et Cartographica Sinica},
  volume = {53},
  number = {12},
  pages = {2316--2327},
  year = {2024},
  institution = {Institute of Surveying and Mapping, Information Engineering University, Zhengzhou 450001, China},
  abstract = {Aiming at the limitations of BPNN in the application of 3D sound velocity field modeling, such as low prediction accuracy, easy to fall into the local optimum, and weak interpretability, a method of the thermohaline field modeling based on BPNNs is proposed, and a sound velocity hierarchical modeling scheme is designed jointly with the empirical equation of sound velocity. Meanwhile, the BPNN function and architecture are improved and optimized by introducing an adaptive particle swarm optimization algorithm to improve the accuracy of the thermohaline field modeling. Experiments on the modeling performance of the proposed algorithm are conducted using BOA_Argo grid data in the central region of the South China Sea. The results show that the algorithm proposed in this paper can fully reflect the physical properties of the ocean sound velocity field, with higher modeling accuracy and robustness than traditional algorithms, and with excellent stability and reliability.},
  keywords = {3D sound velocity field, backpropagation neural network, particle swarm optimization algorithm, BOA_Argo grid data},
  note = {Foundation support: The National Natural Science Foundation of China (No.42074014). First author: WANG Zhaoying (1999), female, postgraduate, majors in hydrographic surveying and charting. E-mail: xdyy1211@163.com. Corresponding author: CHAI Hongzhou. E-mail: chaihz1969@163.com},
}

@article{xiaoSpatiotemporalDeepLearning2019,
